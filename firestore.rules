rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A tree's id is a SHA-256 hash of its name + password.
    // Knowing the id is the same as knowing the password, so:
    //  - you can open a tree only if you already know its id
    //  - nobody can list trees to discover other families
    match /trees/{treeId} {
      allow get: if validId(treeId);
      allow list: if false;
      allow create: if validId(treeId)
        && request.resource.data.keys().hasOnly(['name', 'created'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80;
      // The only thing anyone can ever change on an existing tree is which
      // person the tree opens to by default (name/created are permanent).
      allow update: if validId(treeId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['defaultFocus'])
        && request.resource.data.defaultFocus is string
        && request.resource.data.defaultFocus.size() <= 60;
      allow delete: if false;

      match /people/{personId} {
        allow read: if treeExists(treeId);
        allow delete: if treeExists(treeId);
        allow create, update: if treeExists(treeId) && validPerson(request.resource.data);
      }
    }

    function validId(id) {
      return id.matches('^[0-9a-f]{64}$');
    }
    function treeExists(id) {
      return validId(id) && exists(/databases/$(database)/documents/trees/$(id));
    }
    function validPerson(p) {
      return p.keys().hasOnly(['name', 'firstName', 'middleName', 'lastName', 'maidenName', 'gender', 'born', 'bornMonth', 'bornDay', 'died', 'diedMonth', 'diedDay', 'place', 'note', 'parents', 'spouses', 'notPartnerWith', 'updated', 'placeholder'])
        && p.name is string && p.name.size() <= 200
        && (!('firstName' in p) || (p.firstName is string && p.firstName.size() <= 100))
        && (!('middleName' in p) || (p.middleName is string && p.middleName.size() <= 100))
        && (!('lastName' in p) || (p.lastName is string && p.lastName.size() <= 100))
        && (!('maidenName' in p) || (p.maidenName is string && p.maidenName.size() <= 100))
        && (!('gender' in p) || (p.gender == '' || p.gender == 'm' || p.gender == 'f'))
        && (!('note' in p) || (p.note is string && p.note.size() <= 5000))
        && (!('placeholder' in p) || p.placeholder is bool)
        && p.parents is list && p.parents.size() <= 2
        && p.spouses is list && p.spouses.size() <= 20
        && (!('notPartnerWith' in p) || (p.notPartnerWith is list && p.notPartnerWith.size() <= 20));
    }
  }
}
